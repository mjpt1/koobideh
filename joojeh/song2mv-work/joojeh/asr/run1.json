 "language": "en",
 "segments": [
  {
   "start": 0.0,
   "end": 6.52,
   "text": "Hey everybody forget the burgers forget the fries tonight we're making Persian"
  },
  {
   "start": 6.52,
   "end": 14.86,
   "text": "chicken paradise get your saffron grab your skewers let's make some jujube kebab"
  },
  {
   "start": 15.48,
   "end": 23.56,
   "text": "two pounds of chicken cut into squares boneless thighs or breasts nobody"
  },
  {
   "start": 24.82,
   "end": 28.82,
   "text": "To onion slice, let the flavor flow"
  },
  {
   "start": 29.52,
   "end": 33.08,
   "text": "Add some yogurt, if you like it slow"
  },
  {
   "start": 33.96,
   "end": 36.58,
   "text": "Fresh lemon juice, a little lime"
  },
  {
   "start": 36.58,
   "end": 38.78,
   "text": "Olive oil to make it shine"
  },
  {
   "start": 38.78,
   "end": 41.1,
   "text": "Salt and pepper, just a pinch"
  },
  {
   "start": 41.1,
   "end": 43.72,
   "text": "Turmeric too, for a golden finish"
  },
  {
   "start": 43.72,
   "end": 46.16,
   "text": "But wait a minute, here's the key"
  },
  {
   "start": 46.16,
   "end": 48.38,
   "text": "Saffron water, strong and free"
  },
  {
   "start": 48.38,
   "end": 50.68,
   "text": "Crush those threads at water hot"
  },
  {
   "start": 50.68,
   "end": 53.14,
   "text": "That's the magic, that's the spy"
  },
  {
   "start": 53.14,
   "end": 57.08,
   "text": "Choo-jee, choo-jee, golden chicken come my way"
  },
  {
   "start": 57.08,
   "end": 61.9,
   "text": "This saffron shining lemon bright Persian chicken done just right"
  },
  {
   "start": 61.9,
   "end": 68.26,
   "text": "Choo-jee, choo-jee, let it marinate away On the fire smell that heat"
  },
  {
   "start": 68.26,
   "end": 73.36,
   "text": "Nothing beats this juicy treat Mix it up and coat each piece"
  },
  {
   "start": 73.36,
   "end": 77.86,
   "text": "Let the flavors have their peace Cover tight and chill all night"
  },
  {
   "start": 77.86,
   "end": 82.3,
   "text": "Four hours minimum works just right Don't rust the chicken, let it rest"
  },
  {
   "start": 82.3,
   "end": 85.46,
   "text": "That's how you make the very best before the grill"
  },
  {
   "start": 85.46,
   "end": 89.42,
   "text": "Shake off the sauce, too much marinade can cause a loss"
  },
  {
   "start": 89.42,
   "end": 91.36,
   "text": "Take your skewer, slide them through"
  },
  {
   "start": 91.36,
   "end": 93.78,
   "text": "Leave a little space between each cube"
  },
  {
   "start": 93.78,
   "end": 95.98,
   "text": "Keep the pieces even in size"
  },
  {
   "start": 95.98,
   "end": 98.38,
   "text": "That's how you get that perfect prize"
  },
  {
   "start": 98.38,
   "end": 100.48,
   "text": "Chocobloin flames are low"
  },
  {
   "start": 100.48,
   "end": 102.7,
   "text": "Place the chicken, let it go"
  },
  {
   "start": 102.7,
   "end": 105.12,
   "text": "Turn it off nice and slow"
  },
  {
   "start": 105.12,
   "end": 107.3,
   "text": "Golden edges, start to show"
  },
  {
   "start": 107.3,
   "end": 109.6,
   "text": "Brush with butter, saffron too"
  },
  {
   "start": 109.6,
   "end": 111.68,
   "text": "Lemon butter, coming through"
  },
  {
   "start": 111.68,
   "end": 115.1,
   "text": "Cookin' fully, don't guess the time, 74 degrees"
  },
  {
   "start": 115.1,
   "end": 118.78,
   "text": "That's the line, grilled tomatoes side by side"
  },
  {
   "start": 118.78,
   "end": 122.1,
   "text": "Fresh green herbs and onions fried, saffron rice"
  },
  {
   "start": 122.1,
   "end": 125.26,
   "text": "A little butter, Persian flavors, nothing better"
  },
  {
   "start": 125.26,
   "end": 128.62,
   "text": "Sumac, sprinkled lemon, squeezed, eat it hot"
  },
  {
   "start": 128.62,
   "end": 132.24,
   "text": "Enjoy the feast from Persian kitchens to the world"
  },
  {
   "start": 132.24,
   "end": 134.62,
   "text": "Juject kebab, the golden bird"
  },
  {
   "start": 136.82,
   "end": 140.46,
   "text": "Juject, juject, golden chicken, hip hooray"
  },
  {
   "start": 140.46,
   "end": 145.46,
   "text": "Saffron, lemon, charcoal, heat Persian cooking can't be beat"
  },
  {
   "start": 145.46,
   "end": 149.66,
   "text": "Juje, juje, bring your friends and come this way"
  },
  {
   "start": 149.66,
   "end": 154.06,
   "text": "Rice and butter, herbs so green Best chicken you've ever seen"
  },
  {
   "start": 154.06,
   "end": 161.34,
   "text": "And remember, my friends Saffron is gold, patience is key"
  },
  {
   "start": 161.34,
   "end": 164.72,
   "text": "And never serve raw chicken at your barbecue"
  }
 ],
